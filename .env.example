# Copy to .env and adjust. Never commit real secrets.
#   cp .env.example .env

# HTTP port for the Express server (also serves the static UI)
PORT=3000

# ---------------------------------------------------------------------------
# Application database (npm start / npm run dev)
# ---------------------------------------------------------------------------
# Local example (default in server/config.js when unset):
MONGODB_URI=mongodb://127.0.0.1:27017/groupflow
# Atlas example (replace placeholders):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/groupflow?retryWrites=true&w=majority

# ---------------------------------------------------------------------------
# Integration test database (required for npm test API suites)
# ---------------------------------------------------------------------------
# MUST be set explicitly. Tests never fall back to MONGODB_URI or "groupflow".
# Database name must end with _test (example: groupflow_test).
# Integration tests connect only here and clear data only in this database.
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/groupflow_test

# development | production
NODE_ENV=development

# HttpOnly session cookie name
SESSION_COOKIE_NAME=gf.sid

# Session lifetime in milliseconds (default 7 days)
# SESSION_TTL_MS=604800000

# Invitation lifetime in milliseconds (default 7 days)
# INVITE_TTL_MS=604800000

# bcrypt cost factor (default 12; tests may lower this)
# BCRYPT_COST=12

# ---------------------------------------------------------------------------
# Registration: Cloudflare Turnstile (Managed widget)
# ---------------------------------------------------------------------------
# Official Cloudflare dummy keys for local development / automated tests.
# Use the matching always-pass pair below together (sitekey + secret).
# Production MUST use real widget keys (dummy keys are rejected when NODE_ENV=production).
# Dummy siteverify does not mirror the browser page: live always-pass secret returns
# hostname "example.com" (docs example also shows "localhost" / action "test").
# Non-production code accepts that dummy response only when both keys are official test keys.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Comma-separated hostnames only (no https://, no :port). Used for real (non-dummy) keys.
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Registration: email verification codes
# ---------------------------------------------------------------------------
# Required secret used to HMAC-hash 6-digit codes at rest (never store plaintext codes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REGISTRATION_CODE_PEPPER=

# Optional tuning (defaults shown)
# REGISTRATION_CODE_TTL_MS=600000
# REGISTRATION_CODE_MAX_ATTEMPTS=5
# REGISTRATION_RESEND_COOLDOWN_MS=60000
# REGISTRATION_MAX_STARTS_PER_EMAIL_PER_HOUR=5
# REGISTRATION_MAX_STARTS_PER_IP_PER_HOUR=20
# REGISTRATION_MAX_VERIFY_PER_IP_PER_HOUR=60

# When set to 1 in non-production, API responses may include `devCode` so you can
# verify without reading email (useful with EMAIL_ADAPTER=memory).
# EXPOSE_DEV_VERIFICATION_CODE=1

# ---------------------------------------------------------------------------
# Transactional email (Resend HTTPS API)
# ---------------------------------------------------------------------------
# Production / real delivery: set both, leave EMAIL_ADAPTER unset (defaults to resend).
RESEND_API_KEY=
EMAIL_FROM=

# Local without Resend: use the in-memory adapter (codes are not emailed).
# Combine with EXPOSE_DEV_VERIFICATION_CODE=1 to show the code in the UI.
# This does NOT prove email ownership — configure RESEND_API_KEY + EMAIL_FROM for real mail.
# EMAIL_ADAPTER=memory

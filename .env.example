# Copy to .env and adjust. Never commit real secrets.
#   cp .env.example .env

# HTTP port for the Express server (also serves the static UI)
PORT=3000

# ---------------------------------------------------------------------------
# Application database (npm start / npm run dev)
# ---------------------------------------------------------------------------
# Local example (default in server/config.js when unset):
MONGODB_URI=mongodb://127.0.0.1:27017/groupflow
# Atlas example (replace placeholders):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/groupflow?retryWrites=true&w=majority

# ---------------------------------------------------------------------------
# Integration test database (required for npm test API suites)
# ---------------------------------------------------------------------------
# MUST be set explicitly. Tests never fall back to MONGODB_URI or "groupflow".
# Database name must end with _test (example: groupflow_test).
# Integration tests connect only here and clear data only in this database.
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/groupflow_test

# development | production
NODE_ENV=development

# HttpOnly session cookie name
SESSION_COOKIE_NAME=gf.sid

# Session lifetime in milliseconds (default 7 days)
# SESSION_TTL_MS=604800000

# Invitation lifetime in milliseconds (default 7 days)
# INVITE_TTL_MS=604800000

# bcrypt cost factor (default 12; tests may lower this)
# BCRYPT_COST=12
